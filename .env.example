# Supabase browser client config
# Copy this file to .env and fill in your real project values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional public Cloudflare Turnstile site key for login, signup and password recovery.
# Store the SECRET key only in Supabase Auth CAPTCHA settings, never in VITE_* variables.
VITE_TURNSTILE_SITE_KEY=

# Supabase backfill script config
# Prefer the service role key for backfill:history-summaries
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
