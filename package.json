{
  "name": "formular-one-dashboard",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "backfill:history-summaries": "ts-node-esm ./scripts/backfill-history-summaries.ts",
    "audit:derived-data": "ts-node-esm ./scripts/audit-and-backfill-derived-data.ts",
    "audit:database": "ts-node-esm ./scripts/audit-database-completeness.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:strict": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "fastf1:export-race": "python scripts/export-fastf1-race-data.py",
    "fastf1:export-season": "python scripts/export-fastf1-season-data.py",
    "fastf1:import-sessions": "ts-node-esm ./scripts/import-fastf1-session-analytics.ts",
    "fia:import-upgrades": "ts-node-esm ./scripts/import-fia-car-upgrades.ts",
    "fia:import-upgrades-db": "ts-node-esm ./scripts/import-fia-car-upgrades-db.ts",
    "fia:import-tech-updates": "ts-node-esm ./scripts/import-fia-tech-updates.ts",
    "import:race-sessions": "ts-node-esm ./scripts/import-race-session-results.ts",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@supabase/supabase-js": "^2.100.1",
    "antd": "^5.15.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "i18next": "^26.3.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.22.3",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "axios": "^1.14.0",
    "dotenv": "^17.4.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.3"
  }
}
